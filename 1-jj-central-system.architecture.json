  "cards": [
    {
      "dot": "cyan",
      "title": "單體式 Worker",
      "items": [
        "一個 Worker 檔案 src/index.js 內置 Hono API 與全部業務邏輯",
        "瀏覽器 SPA（public/index.html）以 Service Worker 快取應用外殼",
        "Worker 內建每分鐘 cron，經 web-push（VAPID）發送考勤打卡提醒"
      ]
    },
    {
      "dot": "rose",
      "title": "安全與稽核",
      "items": [
        "登入採 PBKDF2 session cookie jj_session（7 日有效）",
        "角色 admin／manager／teacher，另設會計、HR 等細權限；經理限指定分校",
        "所有非 GET 的成功 API 呼叫自動寫入 audit_logs；家長 token 頁須電話 PIN"
      ]
    },
    {
      "dot": "emerald",
      "title": "外部整合",
      "items": [
        "Workers AI 僅用於老師評語建議與 Jolly Buddy 問答",
        "WhatsApp 只在前端組織 deep link（api.whatsapp.com/send），無伺服器端呼叫",
        "PDF 由前端以 pdf-data 組版下載；AutoPay 出恒生 HKMRI TXT／XLSX"
      ]
    }
  ]
