  "cards": [
    {
      "dot": "cyan",
      "title": "打卡規則",
      "items": [
        "四段順序：上班→午出→午返→下班；順序錯調會被拒",
        "地圍預設 150 米（branch_attendance_settings 可調），另有 WFH 模式",
        "OT 達 30 分鐘以上自動寫入 staff_ot_requests"
      ]
    },
    {
      "dot": "amber",
      "title": "提醒與代課",
      "items": [
        "每分鐘 cron 經 web-push 提醒：返工前 5 分鐘／放工／Lunch 復工",
        "請假影響的課堂在 staff_leave_classes 安排代課導師",
        "批核人：直屬主管（supervisor_user_id）或 HR"
      ]
    },
    {
      "dot": "emerald",
      "title": "介面要點",
      "items": [
        "打卡：POST /api/attendance/punch",
        "請假：POST /api/attendance/leaves",
        "薪津報表：GET /api/reports/teacher-payroll-attendance"
      ]
    }
