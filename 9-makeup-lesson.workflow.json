  "cards": [
    {
      "dot": "cyan",
      "title": "資格規則",
      "items": [
        "原點名紀錄須為 請假／病假／缺席 才可安排補堂",
        "目標堂限同分校、年級相符；跨週須課程允許（makeup_cross_week）",
        "不可選學生自己已報名的班別"
      ]
    },
    {
      "dot": "amber",
      "title": "單據連動",
      "items": [
        "補堂會對調 invoice_items 內的 session_dates，學費不變",
        "取消補堂會回復原紀錄與單據堂日",
        "手動補堂（自訂日期／時間／房間／導師）可獨立點名"
      ]
    },
    {
      "dot": "rose",
      "title": "介面要點",
      "items": [
        "安排補堂：POST /api/students/:id/makeup",
        "選項：GET /api/students/:id/makeup-options/:recordId",
        "取消：DELETE /api/students/:id/makeup/:makeupId"
      ]
    }
  ]
