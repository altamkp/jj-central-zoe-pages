  "cards": [
    {
      "dot": "cyan",
      "title": "退學認定",
      "items": [
        "「已退學」顯示只認 JC 明確退學狀態或退學取消原因（V389）",
        "SchoolTracs 的課程「最後上課日期」只是學期完結，不是退學",
        "真正退學來源：家長申請獲批、同事標記退學、匯入舊課程查詢規則"
      ]
    },
    {
      "dot": "amber",
      "title": "顯示與排程",
      "items": [
        "時間表在學生姓名後顯示「（最後一堂）」",
        "個人資料顯示「已退學 ・ 最後一堂 M/D」",
        "生效日在未來時排入 enrollment_changes，到期自動套用"
      ]
    },
    {
      "dot": "emerald",
      "title": "介面要點",
      "items": [
        "退學：POST /api/students/:id/withdraw",
        "最後一堂後未繳單會取消／重算；受保護單據只提示會計跟進"
      ]
    }
  ]
