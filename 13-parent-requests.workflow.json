  "cards": [
    {
      "dot": "cyan",
      "title": "連結種類",
      "items": [
        "報名表格／請假／補堂／退學／勤學獎／學習遊戲，全部以免登入 token",
        "PIN 驗證失敗多次會鎖定（parent_link_auth_failures）",
        "職員生成：POST /api/students/:id/parent-service-link"
      ]
    },
    {
      "dot": "amber",
      "title": "確認後效果",
      "items": [
        "請假確認→寫入點名「請假」；退學確認→設定 enrollment end_date",
        "補堂確認→建立補堂安排及補堂點名紀錄",
        "可同時申請請假＋補堂；未指明目標堂則由職員安排"
      ]
    },
    {
      "dot": "emerald",
      "title": "介面要點",
      "items": [
        "家長提交：POST /api/parent-service/:token",
        "審批：POST /api/parent-service-requests/:id/review",
        "報名表格另走 parent_form_submissions 確認流程"
      ]
    }
  ]
