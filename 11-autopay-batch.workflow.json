  "cards": [
    {
      "dot": "cyan",
      "title": "設定與限額",
      "items": [
        "銀行帳號加密存於 student_autopay_profiles",
        "限額模式：per_debit（每筆）或 monthly_total（每月總額）",
        "設定：GET／PUT /api/students/:id/autopay"
      ]
    },
    {
      "dot": "emerald",
      "title": "批次流程",
      "items": [
        "預覽：POST /api/autopay/preview（帳號以遮罩顯示）",
        "確立：POST /api/autopay/finalize，收款先記網上過數、待銀行確認",
        "出檔：GET /api/autopay/batches/:id/txt（恒生 HKMRI v1.3）或 /excel"
      ]
    },
    {
      "dot": "rose",
      "title": "例外處理",
      "items": [
        "批次可整批作廢：POST /api/autopay/batches/:id/void，回復單據餘額",
        "超出限額的單會拆 parts（_a/_b）或留在候選之外",
        "舊 SchoolTracs 轉帳資料：POST /api/autopay/st-import/preview｜confirm"
      ]
    }
  ]
