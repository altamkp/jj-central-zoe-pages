  "cards": [
    {
      "dot": "cyan",
      "title": "點名狀態",
      "items": [
        "五種狀態：出席／遲到／缺席／請假／病假，可加備註（V395 修正 D1 CHECK）",
        "遲到保留為獨立狀態，業務上視作已出席",
        "點名與評語可分開儲存；同時修改則一次保存兩項（V393）"
      ]
    },
    {
      "dot": "rose",
      "title": "鎖定與批核",
      "items": [
        "過去堂日全班點名完成即鎖定（lesson_attendance_completions）",
        "未點的舊堂須申請補點名，由 HR 批核後補寫",
        "已鎖堂的更改須申請點名更正，由 admin 批核"
      ]
    },
    {
      "dot": "emerald",
      "title": "介面要點",
      "items": [
        "儲存點名：PUT /api/students/:id/attendance/:sessionId",
        "Skip 日期的點名會被拒（409）",
        "非出席狀態會排入 SchoolTracs 異動；更改請假會連動取消補堂"
      ]
    }
  ]
