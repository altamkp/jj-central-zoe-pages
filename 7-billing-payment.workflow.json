  "cards": [
    {
      "dot": "cyan",
      "title": "出單規則",
      "items": [
        "月結：POST /api/enrollments/:id/monthly-invoice（併入同月未繳）",
        "合併未繳單：POST /api/billing/students/:id/merge-unpaid-invoices",
        "折扣先計課程優惠，AutoPay 95% 之後疊加"
      ]
    },
    {
      "dot": "amber",
      "title": "收款規則",
      "items": [
        "收款：POST /api/invoices/:id/payments（現金／支票／網上過數／ATM）",
        "可用回贈扣帳：student_credits → student_credit_uses",
        "收據編號自動產生：JJ-R-YYYYMMDD-######"
      ]
    },
    {
      "dot": "rose",
      "title": "退單與重出",
      "items": [
        "刪除未繳單：DELETE /api/invoices/:id（軟性作廢並退回回贈）",
        "同班同日重選即重建學費單，不再誤報撞堂（V378／V380）",
        "作廢收據：POST /api/payments/:id/void（理由至少 3 字，重算單據）"
      ]
    }
  ]
